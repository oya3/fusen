<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>fusen</AssemblyName>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <!-- ビルド時に git の情報をアセンブリへ埋め込む（バージョン情報メニュー用・§4.3）。
       実行時に git を呼ばないのは、配布先に git が無く、起動時に外部プロセスを起こすと
       「瞬時の起動」に反するため。git が無い環境やリポジトリ外でビルドした場合は
       値が空になるだけで、ビルドは通す。
       format 指定子の % は MSBuild で %25、さらに cmd で二重化する必要があるため %25%25 と書く。 -->
  <Target Name="EmbedGitInfo" BeforeTargets="GetAssemblyAttributes">
    <Exec Command="git -C &quot;$(MSBuildProjectDirectory)&quot; rev-parse --short HEAD"
          ConsoleToMSBuild="true" ContinueOnError="true" IgnoreExitCode="true"
          StandardOutputImportance="low" StandardErrorImportance="low" UseUtf8Encoding="Always">
      <Output TaskParameter="ConsoleOutput" PropertyName="_GitCommit" />
      <Output TaskParameter="ExitCode" PropertyName="_GitExitCode" />
    </Exec>
    <Exec Command="git -C &quot;$(MSBuildProjectDirectory)&quot; log -1 --date=iso --format=%25%25cd"
          Condition="'$(_GitExitCode)' == '0'"
          ConsoleToMSBuild="true" ContinueOnError="true" IgnoreExitCode="true"
          StandardOutputImportance="low" StandardErrorImportance="low" UseUtf8Encoding="Always">
      <Output TaskParameter="ConsoleOutput" PropertyName="_GitCommitDate" />
    </Exec>
    <Exec Command="git -C &quot;$(MSBuildProjectDirectory)&quot; log -1 --format=%25%25s"
          Condition="'$(_GitExitCode)' == '0'"
          ConsoleToMSBuild="true" ContinueOnError="true" IgnoreExitCode="true"
          StandardOutputImportance="low" StandardErrorImportance="low" UseUtf8Encoding="Always">
      <Output TaskParameter="ConsoleOutput" PropertyName="_GitSubject" />
    </Exec>
    <!-- 未コミットの変更を抱えたままビルドしたものを見分けられるようにする。
         調査用ビルドと配布物が同じハッシュに見えてしまうと、どちらが動いているか分からなくなるため。 -->
    <Exec Command="git -C &quot;$(MSBuildProjectDirectory)&quot; status --porcelain"
          Condition="'$(_GitExitCode)' == '0'"
          ConsoleToMSBuild="true" ContinueOnError="true" IgnoreExitCode="true"
          StandardOutputImportance="low" StandardErrorImportance="low" UseUtf8Encoding="Always">
      <Output TaskParameter="ConsoleOutput" PropertyName="_GitStatus" />
    </Exec>

    <PropertyGroup Condition="'$(_GitExitCode)' == '0'">
      <_GitCommit Condition="'$(_GitStatus)' != ''">$(_GitCommit)-dirty</_GitCommit>
    </PropertyGroup>

    <ItemGroup Condition="'$(_GitExitCode)' == '0'">
      <AssemblyMetadata Include="GitCommit" Value="$(_GitCommit)" />
      <AssemblyMetadata Include="GitCommitDate" Value="$(_GitCommitDate)" />
      <AssemblyMetadata Include="GitCommitSubject" Value="$(_GitSubject)" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <!-- 設定ファイルはリポジトリ直下の fusen.ini を唯一の正とし、リンク参照で出力先へコピーする。
         プロジェクト内に複製を置くと、片方だけ編集されて設定が食い違うため。 -->
    <None Include="../../fusen.ini" Link="fusen.ini">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>

    <!-- 自動起動の設定スクリプト。配布フォルダに同梱するため出力先へコピーする。 -->
    <None Include="../../setup-autostart.ps1" Link="setup-autostart.ps1">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="../../setup-autostart.bat" Link="setup-autostart.bat">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Markdig" Version="1.3.2" />
  </ItemGroup>

</Project>
