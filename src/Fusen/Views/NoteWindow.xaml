<Window x:Class="Fusen.Views.NoteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Fusen.Views"
        xmlns:helpers="clr-namespace:Fusen.Helpers"
        mc:Ignorable="d"
        Title="fusen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        MinWidth="200"
        MinHeight="38"
        Width="280"
        Height="300"
        LocationChanged="Window_LocationChanged"
        SizeChanged="Window_SizeChanged"
        Loaded="Window_Loaded">

    <Window.Resources>
        <helpers:BoolToVisibilityConverter x:Key="BoolToVisConverter" />
        <helpers:InverseBooleanConverter x:Key="InverseBoolConverter" />

        <!-- スタイリッシュなヘッダーボタン用スタイル -->
        <Style x:Key="HeaderButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Margin" Value="1,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#22000000" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#44000000" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- カラー選択サークルボタン用スタイル -->
        <Style x:Key="ColorCircleButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Margin" Value="3" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="circle" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1.5" CornerRadius="12" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="circle" Property="BorderBrush" Value="#333333" />
                                <Setter TargetName="circle" Property="BorderThickness" Value="2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 透過率プリセットボタンスタイル -->
        <Style x:Key="PresetOpacityButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="22" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="Background" Value="#F3F4F6" />
            <Setter Property="Foreground" Value="#374151" />
            <Setter Property="BorderBrush" Value="#E5E7EB" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E0E7FF" />
                                <Setter TargetName="border" Property="BorderBrush" Value="#6366F1" />
                                <Setter Property="Foreground" Value="#4F46E5" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#C7D2FE" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- 外枠ドロップシャドウ付きコンテナ -->
    <Grid Margin="8">
        <Border x:Name="MainBorder" CornerRadius="8" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="12" Direction="270" ShadowDepth="3" Opacity="0.25" Color="#000000" />
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /> <!-- ヘッダー (折りたたみ時はここだけ表示) -->
                    <RowDefinition Height="*" />    <!-- エディタ本文 (折りたたみ時はCollapsed) -->
                </Grid.RowDefinitions>

                <!-- 1. ヘッダー / タイトルバー -->
                <Border x:Name="HeaderBorder" Grid.Row="0" CornerRadius="7,7,0,0" Height="36"
                        MouseLeftButtonDown="Header_MouseLeftButtonDown">
                    <Grid Margin="6,0,4,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />   <!-- タイトル / ドラッグ領域 -->
                            <ColumnDefinition Width="Auto" /> <!-- ツールボタン群 -->
                        </Grid.ColumnDefinitions>

                        <!-- タイトル（折りたたみ時・展開時ともに1行目テキストを表示） -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="TitleTextBlock" Text="新規メモ" FontWeight="SemiBold" FontSize="13"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="120"
                                       ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                        </StackPanel>

                        <!-- 操作ツールボタン群 -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- 新規作成 ＋ -->
                            <Button Style="{StaticResource HeaderButtonStyle}" ToolTip="新しい付箋を作成 (Ctrl+N)" Click="BtnNew_Click">
                                <TextBlock Text="＋" FontSize="14" FontWeight="Bold" Foreground="{Binding ElementName=TitleTextBlock, Path=Foreground}" />
                            </Button>

                            <!-- ピン留め 📌 -->
                            <Button x:Name="BtnPin" Style="{StaticResource HeaderButtonStyle}" ToolTip="最前面にピン留め" Click="BtnPin_Click">
                                <TextBlock x:Name="PinIcon" Text="📌" FontSize="11" Opacity="0.5" />
                            </Button>

                            <!-- カラーパレット 🎨 -->
                            <Button Style="{StaticResource HeaderButtonStyle}" ToolTip="付箋の色を変更" Click="BtnColor_Click">
                                <TextBlock Text="🎨" FontSize="11" />
                            </Button>

                            <!-- メモ一覧 📋 -->
                            <Button Style="{StaticResource HeaderButtonStyle}" ToolTip="メモ一覧を開く (Ctrl+L)" Click="BtnList_Click">
                                <TextBlock Text="📋" FontSize="11" />
                            </Button>

                            <!-- 折りたたみ / 展開 ▲ / ▼ -->
                            <Button x:Name="BtnFold" Style="{StaticResource HeaderButtonStyle}" ToolTip="折りたたみ / 展開 (ダブルクリックでも切替)" Click="BtnFold_Click">
                                <TextBlock x:Name="FoldIcon" Text="▲" FontSize="11" FontWeight="Bold" Foreground="{Binding ElementName=TitleTextBlock, Path=Foreground}" />
                            </Button>

                            <!-- 閉じる（剥がす/削除） ✕ -->
                            <Button Style="{StaticResource HeaderButtonStyle}" ToolTip="この付箋を剥がす（削除）" Click="BtnDelete_Click">
                                <TextBlock Text="✕" FontSize="12" FontWeight="SemiBold" Foreground="{Binding ElementName=TitleTextBlock, Path=Foreground}" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 2. 本文エディタ領域 -->
                <Grid x:Name="ContentArea" Grid.Row="1">
                    <RichTextBox x:Name="NoteRichTextBox"
                                 Margin="8,4,8,8"
                                 Padding="2"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 FontSize="13.5"
                                 FontFamily="Segoe UI, Yu Gothic UI, Meiryo"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Disabled"
                                 AcceptsReturn="True"
                                 AcceptsTab="True"
                                 SpellCheck.IsEnabled="False"
                                 TextChanged="NoteRichTextBox_TextChanged"
                                 PreviewKeyDown="NoteRichTextBox_PreviewKeyDown">
                        <!-- 段落の既定マージンを除去（改行ごとの余分な行間を解消） -->
                        <RichTextBox.Resources>
                            <Style TargetType="{x:Type Paragraph}">
                                <Setter Property="Margin" Value="0" />
                            </Style>
                            <Style TargetType="{x:Type List}">
                                <Setter Property="Margin" Value="0,0,0,0" />
                                <Setter Property="Padding" Value="0,0,0,0" />
                            </Style>
                            <Style TargetType="{x:Type BlockUIContainer}">
                                <Setter Property="Margin" Value="0,2,0,2" />
                            </Style>
                        </RichTextBox.Resources>
                    </RichTextBox>
                </Grid>
            </Grid>
        </Border>

        <!-- カラー＆透過率選択ポップアップ -->
        <Popup x:Name="ColorPickerPopup" StaysOpen="False" AllowsTransparency="True" Placement="Bottom">
            <Border Background="#FFFFFF" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8" Padding="10" MinWidth="210">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="12" ShadowDepth="3" Opacity="0.18" Color="#000000" />
                </Border.Effect>
                <StackPanel>
                    <!-- 1. カラー選択 -->
                    <TextBlock Text="カラー" FontSize="11" FontWeight="SemiBold" Foreground="#6B7280" Margin="2,0,0,6" />
                    <StackPanel x:Name="ColorPaletteStackPanel" Orientation="Horizontal" Margin="0,0,0,8" />

                    <!-- セパレーター -->
                    <Separator Background="#F3F4F6" Margin="0,2,0,8" />

                    <!-- 2. 不透明度（透過率）スライダー -->
                    <Grid Margin="2,0,2,4">
                        <TextBlock Text="不透明度" FontSize="11" FontWeight="SemiBold" Foreground="#6B7280" VerticalAlignment="Center" />
                        <TextBlock x:Name="OpacityValueTextBlock" Text="100%" FontSize="11" FontWeight="Bold" Foreground="#0078D4" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                    <Slider x:Name="OpacitySlider"
                            Minimum="20" Maximum="100" SmallChange="5" LargeChange="10"
                            TickFrequency="5" IsSnapToTickEnabled="False"
                            ValueChanged="OpacitySlider_ValueChanged"
                            Margin="2,2,2,8" Cursor="Hand" />

                    <!-- 3. 透過プリセットボタン (100%, 85%, 70%, 50%) -->
                    <UniformGrid Columns="4" Margin="0,2,0,0">
                        <Button Style="{StaticResource PresetOpacityButtonStyle}" Content="100%" Tag="1.0" Click="BtnPresetOpacity_Click" ToolTip="標準（不透明）" />
                        <Button Style="{StaticResource PresetOpacityButtonStyle}" Content="85%" Tag="0.85" Click="BtnPresetOpacity_Click" ToolTip="すりガラス（推奨）" />
                        <Button Style="{StaticResource PresetOpacityButtonStyle}" Content="70%" Tag="0.7" Click="BtnPresetOpacity_Click" ToolTip="半透明" />
                        <Button Style="{StaticResource PresetOpacityButtonStyle}" Content="50%" Tag="0.5" Click="BtnPresetOpacity_Click" ToolTip="高透過" />
                    </UniformGrid>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</Window>
