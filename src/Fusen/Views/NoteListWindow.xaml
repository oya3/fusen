<Window x:Class="Fusen.Views.NoteListWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Fusen.Views"
        xmlns:models="clr-namespace:Fusen.Models"
        xmlns:helpers="clr-namespace:Fusen.Helpers"
        mc:Ignorable="d"
        Title="fusen - メモ一覧マネージャー"
        Width="540" Height="620"
        MinWidth="400" MinHeight="400"
        WindowStartupLocation="CenterScreen"
        Background="#F5F6F8"
        FontFamily="Segoe UI, Yu Gothic UI, Meiryo">

    <Window.Resources>
        <helpers:BoolToVisibilityConverter x:Key="BoolToVisConverter" />
        <helpers:InverseBooleanConverter x:Key="InverseBoolConverter" />
        <helpers:ThemeToHeaderBrushConverter x:Key="ThemeToBrushConverter" />

        <!-- ボタンスタイル -->
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#E0E0E0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#EBF3FB" />
                                <Setter TargetName="border" Property="BorderBrush" Value="#2196F3" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#D0E4F7" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryActionButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Background" Value="#0078D4" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#106EBE" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#005A9E" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- ヘッダー / 検索バー -->
            <RowDefinition Height="Auto" /> <!-- ツールバー -->
            <RowDefinition Height="*" />    <!-- リストビュー -->
            <RowDefinition Height="Auto" /> <!-- フッター -->
        </Grid.RowDefinitions>

        <!-- 1. 検索バー -->
        <Border Grid.Row="0" Background="#FFFFFF" CornerRadius="8" BorderBrush="#E0E0E0" BorderThickness="1" Padding="8,6" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="🔍" FontSize="13" VerticalAlignment="Center" Margin="4,0,8,0" Opacity="0.6" />
                <TextBox x:Name="SearchTextBox" Grid.Column="1" BorderThickness="0" Background="Transparent"
                         FontSize="13.5" VerticalAlignment="Center" TextChanged="SearchTextBox_TextChanged" />
                <TextBlock Grid.Column="1" Text="メモを検索..." FontSize="13.5" VerticalAlignment="Center"
                           Foreground="#999999" IsHitTestVisible="False" Margin="2,0,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ElementName=SearchTextBox, Path=Text}" Value="">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <Button Grid.Column="2" Content="✕" Width="20" Height="20" Background="Transparent" BorderThickness="0"
                        Cursor="Hand" Visibility="{Binding ElementName=SearchTextBox, Path=Text.IsEmpty, Converter={StaticResource BoolToVisConverter}, ConverterParameter=invert}"
                        Click="BtnClearSearch_Click" />
            </Grid>
        </Border>

        <!-- 2. アクションツールバー -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource PrimaryActionButtonStyle}" Content="＋ 新規付箋" Click="BtnNew_Click" Margin="0,0,8,0" />
                <Button Style="{StaticResource ActionButtonStyle}" Content="▲ すべて折りたたむ" Click="BtnFoldAll_Click" Margin="0,0,6,0" />
                <Button Style="{StaticResource ActionButtonStyle}" Content="▼ すべて展開" Click="BtnExpandAll_Click" Margin="0,0,6,0" />
                <Button Style="{StaticResource ActionButtonStyle}" Content="📂 データフォルダ" Click="BtnOpenDataDir_Click" />
            </StackPanel>
        </Grid>

        <!-- 3. メモカード一覧リスト -->
        <Border Grid.Row="2" Background="#FFFFFF" CornerRadius="8" BorderBrush="#E5E7EB" BorderThickness="1">
            <ListBox x:Name="NotesListBox" BorderThickness="0" Background="Transparent"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     MouseDoubleClick="NotesListBox_MouseDoubleClick"
                     Padding="8">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,0,0,8" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter />
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#FAFAFA" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="6" Padding="12,10">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.08" />
                            </Border.Effect>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="6" />   <!-- カラーバー -->
                                    <ColumnDefinition Width="*" />   <!-- タイトルと本文プレビュー -->
                                    <ColumnDefinition Width="Auto" /> <!-- 操作ボタン群 -->
                                </Grid.ColumnDefinitions>

                                <!-- カラーバー -->
                                <Border Grid.Column="0" Background="{Binding ColorTheme, Converter={StaticResource ThemeToBrushConverter}}"
                                        CornerRadius="3" Margin="0,0,10,0" Width="4" HorizontalAlignment="Left" />

                                <!-- メモ内容 -->
                                <StackPanel Grid.Column="1" Margin="4,0,12,0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="14" Foreground="#1F2937"
                                                   TextTrimming="CharacterEllipsis" MaxWidth="260" />
                                        <TextBlock Text="📌" FontSize="11" Margin="6,0,0,0" VerticalAlignment="Center"
                                                   Visibility="{Binding IsPinned, Converter={StaticResource BoolToVisConverter}}" />
                                        <TextBlock Text="🔽折りたたみ中" FontSize="10" Foreground="#6B7280" Margin="6,0,0,0" VerticalAlignment="Center"
                                                   Visibility="{Binding IsFolded, Converter={StaticResource BoolToVisConverter}}" />
                                    </StackPanel>

                                    <!-- 本文プレビュー -->
                                    <TextBlock Text="{Binding PlainText}" FontSize="12" Foreground="#4B5563"
                                               MaxHeight="36" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" Margin="0,0,0,6" />

                                    <!-- 更新日時と状態 -->
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding UpdatedAt, StringFormat='更新: yyyy/MM/dd HH:mm'}"
                                                   FontSize="11" Foreground="#9CA3AF" />
                                        <TextBlock Text=" • " FontSize="11" Foreground="#9CA3AF" />
                                        <TextBlock FontSize="11" FontWeight="SemiBold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="デスクトップ表示中" />
                                                    <Setter Property="Foreground" Value="#10B981" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsVisible}" Value="False">
                                                            <Setter Property="Text" Value="保管中（剥がし済み）" />
                                                            <Setter Property="Foreground" Value="#9CA3AF" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </StackPanel>

                                <!-- 操作ボタン群 -->
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <!-- フォーカス / 開く -->
                                    <Button Style="{StaticResource ActionButtonStyle}" ToolTip="この付箋へ移動・最前面に表示"
                                            Click="BtnFocusItem_Click" Tag="{Binding}" Margin="0,0,4,0">
                                        <TextBlock Text="🎯 開く" FontSize="11.5" />
                                    </Button>

                                    <!-- 剥がす（保管）/ 貼る（表示）切り替え -->
                                    <Button Click="BtnToggleVisibility_Click" Tag="{Binding}" Margin="0,0,4,0">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
                                                <Setter Property="ToolTip" Value="デスクトップから剥がして保管" />
                                                <Setter Property="Content" Value="👁️ 剥がす" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsVisible}" Value="False">
                                                        <Setter Property="ToolTip" Value="デスクトップに貼り直す" />
                                                        <Setter Property="Content" Value="📌 貼る" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>

                                    <!-- 完全削除 -->
                                    <Button Style="{StaticResource ActionButtonStyle}" ToolTip="この付箋を完全に削除"
                                            Click="BtnDeleteItem_Click" Tag="{Binding}" Background="#FFF1F2" BorderBrush="#FECDD3">
                                        <TextBlock Text="🗑️" FontSize="11.5" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <!-- 4. フッター（件数表示） -->
        <Grid Grid.Row="3" Margin="0,8,0,0">
            <TextBlock x:Name="NotesCountTextBlock" Text="全 0 件のメモ" FontSize="11.5" Foreground="#6B7280" />
            <TextBlock Text="ダブルクリックで該当の付箋へジャンプ" FontSize="11.5" Foreground="#9CA3AF" HorizontalAlignment="Right" />
        </Grid>
    </Grid>
</Window>
